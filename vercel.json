{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "API_KEYS": "prod-key-abc123,admin-key-xyz789,user-key-def456",
    "MASTER_API_KEY": "master-key-ultimate"
  }
}
